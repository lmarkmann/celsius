{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended"],

  timezone: "Europe/Berlin",
  schedule: ["before 7am on monday"],
  labels: ["dependencies"],
  prConcurrentLimit: 3,
  // A crates.io release cannot be unpublished, but it can be yanked. Waiting three
  // days means a bad release is usually already yanked before a PR opens for it.
  minimumReleaseAge: "3 days",
  separateMinorPatch: true,

  // Merge through GitHub's own auto-merge rather than having Renovate merge on a later
  // run. GitHub then holds the PR until the required check passes, so nothing lands on
  // a red build, and the merge happens minutes after CI rather than up to a week later
  // when the Monday schedule next fires.
  platformAutomerge: true,

  // Installs the toolchain Renovate runs `cargo update` with. "1.88" is a range in
  // rust-release-channel versioning, so the resolver picks the newest 1.88.x rather
  // than failing to parse a single version.
  //
  // This used to carry a second, scoped rule pinning the crate datasource to "~1.88",
  // which is the only spelling that filters correctly: release filtering runs under
  // cargo versioning, where a bare "1.88" reads as ^1.88, and a crate declaring
  // "1.90.0" satisfies that, so it slips through. It was removed anyway. Renovate
  // validates constraints.rust against rust-release-channel whatever datasource the
  // rule is scoped to, "~1.88" is not valid there, and every run reported a config
  // warning; upstream says that warning may become a hard error. constraintsVersioning
  // cannot override it either, because it rejects tool names and rust is one.
  //
  // So the msrv job in ci.yml is the floor now, and it always was the real one: it runs
  // cargo check --locked pinned to 1.88.0, so a dependency that raises the floor turns
  // that job red and automerge never fires. The cost is a doomed PR opening a few times
  // a year instead of being filtered before it is raised. That is the cheaper failure.
  constraints: {
    rust: "1.88",
  },

  packageRules: [
    {
      // Both of these are the 1.88 floor itself, not dependencies to keep current.
      // Renovate reads its own config with the renovate-config manager and offered to
      // move constraints.rust to 1.98; the msrv job's toolchain is the same trap from
      // the other side. The floor moves by hand, together with rust-version in
      // Cargo.toml, or not at all.
      matchManagers: ["renovate-config", "github-actions"],
      matchPackageNames: ["rust", "dtolnay/rust-toolchain"],
      enabled: false,
    },
    {
      // Cargo.toml carries loose ranges, so patch updates land in Cargo.lock alone and
      // there is nothing to review one crate at a time.
      matchManagers: ["cargo"],
      matchUpdateTypes: ["patch"],
      groupName: "cargo patch updates",
      automerge: true,
    },
    {
      // Actions are tag-pinned, so a bump moves what a tag resolves to, which is the
      // tj-actions vector. The three-day cooldown above is the protection that makes
      // automerging these reasonable: a compromised release is usually pulled inside it.
      matchManagers: ["github-actions"],
      groupName: "github actions",
      automerge: true,
    },
    {
      // ratatui and crossterm are 0.x, so a minor bump is a breaking one, and it moves
      // the pinned floor in Cargo.toml rather than only the lockfile.
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "major"],
      groupName: null,
      labels: ["dependencies", "needs-review"],
      automerge: false,
    },
  ],

  // Refreshes transitive dependencies that no direct requirement pulls forward.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 7am on the first day of the month"],
    automerge: true,
  },
}
